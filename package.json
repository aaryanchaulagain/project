{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "inn-group-platform",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "next lint",
